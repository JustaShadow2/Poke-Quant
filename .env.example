# Copy to .env and fill in. Never commit real secrets.

# --- Environment ---
POKEQUANT_ENV=local            # local | staging | production
LOG_LEVEL=INFO
LOG_JSON=false                 # true -> JSON logs (prod), false -> console (dev)

# --- Database (Postgres + TimescaleDB) ---
# Matches docker-compose service "db".
DATABASE_URL=postgresql+psycopg://pokequant:pokequant@localhost:5432/pokequant

# --- Cache / broker (optional in Phase 1) ---
REDIS_URL=redis://localhost:6379/0

# --- Artifacts (model files, datasets) ---
ARTIFACT_DIR=./data/artifacts

# --- Safety flag: never let synthetic data drive user-facing advice ---
ALLOW_SYNTHETIC_IN_SCORING=false

# --- CORS (frontend origin) ---
CORS_ORIGINS=http://localhost:3000

# --- AI assistant (Groq — free-tier models with automatic fallback) ---
# Get a free key at https://console.groq.com/keys
# Without it, the /assistant/chat endpoint returns a "not configured" message.
GROQ_API_KEY=

# --- Data provider credentials (all optional; pipeline degrades/uses synthetic without them) ---
POKEMONTCG_API_KEY=
FRED_API_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# --- Bootstrap (Docker/Render first-boot demo data generation) ---
# 1 = generate synthetic demo data on first boot (default)
# 0 = skip; force = regenerate every boot
BOOTSTRAP=1

# Optional later: live PSA 9/10 comps (not wired yet — Grade tab uses estimates).
# PRICECHARTING_TOKEN=

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
